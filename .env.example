# ---------------------------------------------------------------------------
# Solana Token Purchase Monitor - configuration template
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and
# must never be committed. Every variable is validated at start-up; invalid or
# missing required values cause a clear, non-secret-leaking error message.
# ---------------------------------------------------------------------------

# --- Telegram (required) ----------------------------------------------------
# Bot token from @BotFather, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user IDs allowed to run state-changing commands
# (/set_wallet, /start_monitoring, /stop_monitoring). Comma separated.
# Security: while this list is empty, mutating commands are refused for
# everybody (fail-closed). Send /whoami to the bot to learn your user ID.
TELEGRAM_ADMIN_USER_IDS=

# Optional allowlist of chats the bot answers in (comma separated chat IDs).
# Leave empty to allow every chat that can reach the bot. Set it to your
# monitoring group to make the bot ignore everything else.
TELEGRAM_ALLOWED_CHAT_IDS=
# Commands per user per minute (abuse protection).
TELEGRAM_COMMANDS_PER_MINUTE=12

# --- Helius (required) ------------------------------------------------------
# API key from https://dashboard.helius.dev
HELIUS_API_KEY=
# Override only if you proxy Helius or use a devnet key.
HELIUS_API_BASE_URL=https://mainnet.helius-rpc.com
# `confirmed` gives the lowest alert latency; `finalized` is more conservative.
HELIUS_COMMITMENT=confirmed
# none | balanceChanged | all - `balanceChanged` also sees token account activity.
HELIUS_TOKEN_ACCOUNTS=balanceChanged
# Transactions per request (Helius maximum is 100).
HELIUS_PAGE_SIZE=100
HELIUS_TIMEOUT_SECONDS=20
# Client-side ceiling; the free/developer plans allow 2 and 10 requests/second.
HELIUS_REQUESTS_PER_SECOND=2
# Retry budget for retryable failures (429, 5xx, network).
HELIUS_MAX_RETRIES=4
HELIUS_RETRY_BASE_SECONDS=0.5
HELIUS_RETRY_MAX_SECONDS=20
# How long a resolved token symbol/decimals stays cached.
HELIUS_METADATA_CACHE_SECONDS=3600

# --- Monitoring -------------------------------------------------------------
# Seconds between polls. NOTE: every poll costs ~100 Helius credits, so this is
# the main driver of API cost. 20s is a good latency/cost compromise; see
# docs/OPERATIONS.md for the credit math.
MONITOR_POLL_INTERVAL_SECONDS=20
# Alert when a token arrives without an obvious payment (airdrop/transfer in).
MONITOR_ALERT_ON_RECEIPTS=true
# Alert when a mint that was already alerted is bought again.
MONITOR_ALERT_ON_REPEAT=false
# Resume monitoring automatically after a restart.
MONITOR_RESUME_ON_START=true
# Mints that never trigger an alert (wrapped SOL by default).
# MONITOR_IGNORED_MINTS=So11111111111111111111111111111111111111112
# Pages fetched per poll when catching up after downtime (100 transactions each).
MONITOR_MAX_CATCHUP_PAGES=10
# Upper bound for the exponential backoff between failing polls.
MONITOR_MAX_BACKOFF_SECONDS=300
# Duplicate-suppression memory (FIFO, oldest entries evicted).
MONITOR_MAX_SEEN_MINTS=5000
MONITOR_MAX_PROCESSED_SIGNATURES=2000

# --- /analyze ---------------------------------------------------------------
# Pages scanned per /analyze request, and how many tokens are listed.
ANALYZE_MAX_PAGES=10
ANALYZE_MAX_TOKENS_LISTED=10

# --- Alert links ------------------------------------------------------------
ALERTS_DEXSCREENER_BASE_URL=https://dexscreener.com/solana
# Telegram username used for the "Buy" button; leave empty to remove the button.
ALERTS_TROJAN_BOT_USERNAME=achilles_trojanbot

# --- Paths / logging --------------------------------------------------------
STATE_FILE=var/state.json
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
